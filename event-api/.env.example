PORT=5000
# SQLite file (created automatically)
DB_FILE=data/events.db
# REQUIRED in production - use a long random string
JWT_SECRET=any-long-random-string-here
JWT_EXPIRES_IN=7d
# Comma-separated allowed origins for the React app, or * for any
CORS_ORIGIN=http://localhost:5173
# An admin account is created/promoted on startup if both are set
ADMIN_NAME=Admin
